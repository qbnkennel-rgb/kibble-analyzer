    },
    "size": {
      "type": "string",
      "enum": [
        "toy",
        "small",
        "medium",
        "large",
        "x-large"
      ],
      "description": "Dog's size"
    },
    "weight": {
      "type": "string",
      "description": "Dog's weight in lbs"
    },
    "activityLevel": {
      "type": "string",
      "enum": [
