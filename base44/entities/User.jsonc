{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has an active paid subscription"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    }
  },
  "required": [
    "stripe_customer_id",
    "stripe_subscription_id"
  ]
}