      "description": "Dog's activity level"
    },
    "foodGoal": {
      "type": "string",
      "enum": [
        "anti-yeast",
        "overall health",
        "allergies",
        "skin/coat health",
        "heart health",
        "joint health",
        "reproduction"
      ],
      "description": "Primary food goal"
    },
    "zipCode": {
      "type": "string",
      "description": "Location zip code"
    },
    "ageYears": {
      "type": "string",
      "description": "Age in years"
    },
    "ageMonths": {
      "type": "string",
      "description": "Age in months"
    }
  },
  "required": [
